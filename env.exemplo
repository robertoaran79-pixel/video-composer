# Copie este arquivo para .env (opcional).
# As chaves também podem ser informadas na tela Configurações; lá elas ficam
# num volume do Docker, fora da pasta de trabalho. O .env nunca deve ir para a nuvem.

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Pasta de trabalho no computador (caminho absoluto). Vazio = ./trabalho
PASTA_TRABALHO=
